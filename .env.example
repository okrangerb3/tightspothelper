# ── Database (Railway PostgreSQL) ─────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── better-auth ───────────────────────────────────────────────
BETTER_AUTH_SECRET=                    # openssl rand -hex 32
BETTER_AUTH_URL=https://tightspothelper.com

# ── OAuth providers (optional) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Run: node scripts/create-stripe-prices.js → paste IDs below
STRIPE_PRICE_STORAGE_BASIC=
STRIPE_PRICE_STORAGE_PRO=
STRIPE_PRICE_STORAGE_UNLIMITED=

# ── Cloudflare R2 ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tightspothelper-recordings
R2_PUBLIC_URL=

# ── Resend ────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@tightspothelper.com

# ── Checkr ────────────────────────────────────────────────────
CHECKR_API_KEY=
CHECKR_WEBHOOK_SECRET=

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://tightspothelper.com
CRON_SECRET=
NODE_ENV=production
PORT=3000
